DISCORD_TOKEN=
MONGO_URI=mongodb://127.0.0.1:27017/napakoe
# Если указан — слэш-команды регистрируются только на этом сервере (мгновенно). Иначе глобально.
DEV_GUILD_ID=

# Часовой пояс и расписание автопроверки AFK (кроме неё проверка идёт и через 30 секунд после старта)
CRON_TZ=Europe/Vilnius
AFK_CRON=0 4 * * *

# Веб-дашборд. Без пароля (минимум 8 символов) дашборд не запускается.
DASHBOARD_PASSWORD=
DASHBOARD_PORT=3000
# 127.0.0.1 — только локально. Для доступа извне поставьте 0.0.0.0 и закройте дашборд HTTPS-прокси.
DASHBOARD_HOST=127.0.0.1
